{
  "name": "spring-letter-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "clean": "powershell -NoProfile -File scripts/clean.ps1",
    "check:ui": "node tests/browser.mjs",
    "check:static": "node tests/static.mjs",
    "audit": "node scripts/audit.mjs",
    "check:motion": "node tests/motion.mjs",
    "check:content": "node tests/content.mjs",
    "check:pages": "node tests/pages.mjs",
    "check:navigation": "node tests/navigation.mjs",
    "check:recovery": "node tests/render-recovery.mjs",
    "check:entry": "node tests/home-entry.mjs",
    "check:projects": "node tests/project-interactions.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.5.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
